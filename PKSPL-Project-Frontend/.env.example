# API URL Backend (Gunakan /api/v1 untuk single-origin reverse proxy / Cloudflare Tunnel, atau http://localhost:8000/api/v1 untuk koneksi langsung)
VITE_API_URL=/api/v1

# Tile Map Configuration (OpenStreetMap / Geospatial)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors

# Laravel Reverb Realtime WebSocket
VITE_REVERB_APP_KEY=pkspl-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8085
VITE_REVERB_SCHEME=http
